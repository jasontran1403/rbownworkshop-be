<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Log ra console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Log ra file log.txt -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>log.txt</file>
        <append>false</append> <!-- false = ghi đè mỗi lần restart; true = append -->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Chỉ log của ExcelParserService ra file log.txt -->
    <logger name="com.rbownworkshop.server.service.ExcelParserService"
            level="INFO"
            additivity="false">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Root logger vẫn log ra console như thường -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>